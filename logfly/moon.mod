name = "chensuiyi/logfly"

version = "0.1.0"

source = "src"

preferred_target = "native"

supported_targets = "native"

license = "MIT"

readme = "README.md"

description = "Logging for MoonBit: plain text and JSONL appenders with timestamps, and size-triggered log rotation"

keywords = [ "log", "logging", "jsonl", "rotate", "append" ]

repository = "https://github.com/chenbimo/moonbit"

import {
  "moonbitlang/x@0.5.1",
  "chensuiyi/fsx@0.1.0",
  "chensuiyi/dateku@0.1.0",
  "chensuiyi/fndash@0.1.0",
}
