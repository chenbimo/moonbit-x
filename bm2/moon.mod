name = "chensuiyi/bm2"

version = "0.5.0"

source = "src"

preferred_target = "native"

supported_targets = "native"

license = "MIT"

readme = "README.md"

repository = "https://github.com/chenbimo/bm2"

description = "A lightweight Linux process manager for Bun and Node.js applications, written in MoonBit"

keywords = [ "bun", "nodejs", "process-manager", "linux" ]

import {
  "moonbit-community/toml@0.5.0",
  "moonbitlang/x@0.5.1",
  "moonbitlang/async@0.22.4",
  "chensuiyi/notify@0.4.0",
  "chensuiyi/dateku@0.1.0",
  "chensuiyi/semver@0.1.0",
  "chensuiyi/subproc@0.1.0",
  "chensuiyi/fsx@0.1.0",
  "chensuiyi/fndash@0.1.0",
  "chensuiyi/logfly@0.1.0",
  "chensuiyi/dcipc@0.1.0",
}
